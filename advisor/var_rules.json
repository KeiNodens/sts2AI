{
  "_doc": {
    "about": "mod 独自 DynamicVar の意味ルール。静的解析(DLL デコンパイル)とトレース観測から人手キュレーション。",
    "structure": "mod プレフィックス(カードID prefix or pool) → var名 → {op, tgt?, pool?, note?, cond?}",
    "ops": "sig.py の op 語彙 + conditional_bonus(条件付き加算) + spend_resource(消費) + add_card(生成) + note(注記のみ)",
    "precedence": "derive_sig で未知 var を見たとき、名前推定より先にここを引く。rule マッチは guess:true だが conf 高め。"
  },
  "LUST_TRAVEL2_": {
    "_mod": "LustTravel2",
    "_systems": {
      "stamina": "敵スタミナゲージ(EnemyStaminaPower)。0で即死(ボス含む)。HPとは別勝利筋",
      "spirit": "不死魂魄(UndeadSpiritPower)。FoxHime の自リソース",
      "release": "解放ティア(スキルツリー連動)。発動中は Release* がボーナス値になる",
      "desire": "欲望(Elise系リソース)",
      "climax": "絶頂カウンタ(Climax到達で効果)"
    },
    "EnemyStaminaDamage": {"op": "mod_damage", "pool": "stamina", "note": "EnemyStaminaPower へダメージ、0で即死"},
    "StaminaDamage": {"op": "mod_damage", "pool": "stamina"},
    "StaminaLoss": {"op": "mod_damage", "pool": "stamina", "note": "敵スタミナ減少"},
    "StaminaRestore": {"op": "heal", "tgt": "enemy", "pool": "stamina", "note": "敵スタミナ回復(不利)"},
    "SpiritAmount": {"op": "gain_resource", "pool": "spirit", "note": "不死魂魄の獲得量"},
    "SpiritCost": {"op": "spend_resource", "pool": "spirit", "note": "不死魂魄を消費"},
    "SpiritMin": {"op": "condition", "note": "魂魄がこの値以上必要"},
    "SpiritThreshold": {"op": "condition", "note": "魂魄閾値(未満で BonusDamage 等が発動)"},
    "SpiritPerTeammate": {"op": "gain_resource", "pool": "spirit", "note": "味方1人あたり魂魄"},
    "BonusDamage": {"op": "conditional_bonus", "of": "damage", "note": "条件成立時にダメージ加算"},
    "BonusBlock": {"op": "conditional_bonus", "of": "block"},
    "ReleaseDamage": {"op": "conditional_bonus", "of": "damage", "cond": "release", "note": "解放発動中の追加ダメ"},
    "ReleaseBlock": {"op": "conditional_bonus", "of": "block", "cond": "release"},
    "ReleaseDraw": {"op": "conditional_bonus", "of": "draw", "cond": "release"},
    "ReleaseStamina": {"op": "conditional_bonus", "of": "mod_damage", "cond": "release", "pool": "stamina"},
    "ReleaseSpirit": {"op": "conditional_bonus", "of": "gain_resource", "cond": "release", "pool": "spirit"},
    "Desire": {"op": "gain_resource", "pool": "desire"},
    "PleasureAdd": {"op": "add_card", "ref": "LUST_TRAVEL2_CARD_PLEASURE", "note": "快楽カードを山札に追加"},
    "Climax": {"op": "gain_resource", "pool": "climax"},
    "ClimaxThreshold": {"op": "condition", "note": "絶頂閾値"},
    "ClimaxCount": {"op": "condition", "note": "絶頂回数カウンタ"},
    "SummonCount": {"op": "summon", "note": "オーブ/使い魔の召喚数"},
    "OrbAttack": {"op": "condition", "note": "召喚物の攻撃力"},
    "OrbHp": {"op": "condition", "note": "召喚物のHP"},
    "EnergyNextTurn": {"op": "gain_energy", "cond": "next_turn", "note": "次ターンのエネルギー"},
    "GambleDraw": {"op": "draw", "cond": "gamble", "note": "賭け成功時ドロー"},
    "GambleBlock": {"op": "block", "cond": "gamble"},
    "GambleTimes": {"op": "condition", "note": "賭けの回数"},
    "StrengthLoss": {"op": "apply_power", "power": "STRENGTH_POWER", "tgt": "enemy", "sign": -1, "note": "敵 Strength 減少"},
    "Discard": {"op": "discard", "note": "手札から捨てる"},
    "Draw": {"op": "draw"},
    "Pick": {"op": "condition", "note": "選択枚数"},
    "HandTarget": {"op": "condition", "note": "手札対象の指定数"},
    "MaxExhaust": {"op": "condition", "note": "廃棄上限"},
    "UpgradeBonus": {"op": "condition", "note": "アップグレード時ボーナス"},
    "Hits": {"op": "repeat", "note": "ヒット数"},
    "EnergyGain": {"op": "gain_energy"},
    "Threshold": {"op": "condition"}
